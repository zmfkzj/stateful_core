+class _ConfiguredLoopPolicy(asyncio.DefaultEventLoopPolicy):
+    def __init__(self, loop_factory: LoopFactory) -> None:
+        super().__init__()
+        self._loop_factory = loop_factory
+
+    def new_event_loop(self) -> AbstractEventLoop:
+        return self._loop_factory()
+
+
+def _get_configured_loop_factory(config: Config) -> LoopFactory | None:
+    configured_factory = config.getini("asyncio_loop_factory")
+    if not configured_factory:
+        return None
+    module_name, separator, factory_name = configured_factory.partition(":")
+    if not module_name or not separator or not factory_name:
+        raise pytest.UsageError(
+            "asyncio_loop_factory must name a callable as 'module:callable'."
+        )
+    try:
+        factory = getattr(importlib.import_module(module_name), factory_name)
+    except (ImportError, AttributeError) as error:
+        raise pytest.UsageError(
+            f"asyncio_loop_factory {configured_factory!r} cannot be imported."
+        ) from error
+    if not callable(factory):
+        raise pytest.UsageError(
+            f"asyncio_loop_factory {configured_factory!r} is not callable."
+        )
+    return factory
+
