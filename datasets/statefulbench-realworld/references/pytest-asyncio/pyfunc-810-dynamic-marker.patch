+def _get_marker_loop_factory(item: Item) -> LoopFactory | None:
+    asyncio_marker = item.get_closest_marker("asyncio")
+    if asyncio_marker is None:
+        return None
+    _, selected_factory_names = _parse_asyncio_marker(asyncio_marker)
+    if selected_factory_names is None:
+        return None
+    hook_factories = _collect_hook_loop_factories(item.config, item)
+    if hook_factories is None:
+        raise pytest.UsageError(
+            "mark.asyncio 'loop_factories' requires at least one "
+            "pytest_asyncio_loop_factories hook implementation."
+        )
+    if len(selected_factory_names) != 1:
+        raise pytest.UsageError(
+            "mark.asyncio 'loop_factories' added after collection must name "
+            "exactly one factory."
+        )
+    factory_name = selected_factory_names[0]
+    try:
+        return hook_factories[factory_name]
+    except KeyError:
+        pytest.skip(
+            reason=(
+                f"Loop factory {factory_name!r} is not available."
+                f" Available factories:"
+                f" {', '.join(hook_factories)}."
+            ),
+        )
+
