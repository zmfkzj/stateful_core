diff --git a/src/xdist/plugin.py b/src/xdist/plugin.py
--- a/src/xdist/plugin.py
+++ b/src/xdist/plugin.py
@@ -133,8 +133,8 @@ def pytest_xdist_auto_num_workers(config: pytest.Config) -> int:
     return 1
 
 
-def parse_numprocesses(s: str) -> int | Literal["auto", "logical"]:
