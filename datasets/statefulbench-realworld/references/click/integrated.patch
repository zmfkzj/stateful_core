diff --git a/src/click/shell_completion.py b/src/click/shell_completion.py
index 5652214..d44970b 100644
--- a/src/click/shell_completion.py
+++ b/src/click/shell_completion.py
@@ -610,7 +610,26 @@ def _resolve_context(
     :param prog_name: Name of the executable in the shell.
     :param args: List of complete args before the incomplete value.
     """
+    default_map = dict(ctx_args.get("default_map") or ())
+
+    for param in cli.params:
+        if param.name is not None and callable(param.default):
+            default_map.setdefault(param.name, None)
+
+    if default_map:
+        ctx_args = {**ctx_args, "default_map": default_map}
     ctx_args["resilient_parsing"] = True
+    if args:
+        for param in cli.params:
+            if (
+                isinstance(param, Option)
+                and not param.is_flag
+                and not param.count
+                and param.flag_value is None
+                and args[-1] in param.opts
+            ):
+                args = args[:-1]
+                break
     with cli.make_context(prog_name, args.copy(), **ctx_args) as ctx:
         args = ctx._protected_args + ctx.args
 
