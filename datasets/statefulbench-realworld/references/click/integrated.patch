     :param args: List of complete args before the incomplete value.
     """
+    def _trim_incomplete_option(command: Command, args: list[str]) -> list[str]:
+        if args:
+            for param in command.params:
+                if (
+                    isinstance(param, Option)
+                    and not param.is_flag
+                    and not param.count
+                    and param.flag_value is None
+                    and args[-1] in param.opts
+                ):
+                    return args[:-1]
+
+        return args
+
+    def _make_context(
+        command: Command,
+        info_name: str | None,
+        args: list[str],
+        **extra: t.Any,
+    ) -> Context:
+        default_map = extra.get("default_map")
+        parent = extra.get("parent")
+
+        if (
+            default_map is None
+            and parent is not None
+            and parent.default_map is not None
+        ):
+            default_map = parent.default_map.get(info_name)
+
+        default_map = dict(default_map or ())
+
+        for param in command.params:
+            if param.name is not None and callable(param.default):
+                default_map.setdefault(param.name, None)
+
+        if default_map:
+            extra["default_map"] = default_map
+
+        return command.make_context(info_name, args, **extra)
+
     ctx_args["resilient_parsing"] = True
