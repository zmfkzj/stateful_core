diff --git a/jsonschema/_keywords.py b/jsonschema/_keywords.py
index 65e3a79..d13d53c 100644
--- a/jsonschema/_keywords.py
+++ b/jsonschema/_keywords.py
@@ -209,6 +209,17 @@ def uniqueItems(validator, uI, instance, schema):
         and validator.is_type(instance, "array")
         and not uniq(instance)
     ):
-        yield ValidationError(f"{instance!r} has non-unique elements")
+        duplicate_item_contexts = []
+        previous = []
+        for index, item in enumerate(instance):
+            for first_index, earlier in enumerate(previous):
+                if equal(item, earlier):
+                    duplicate_item_contexts.append((first_index, index, item))
+                    break
+            previous.append(item)
+
+        error = ValidationError(f"{instance!r} has non-unique elements")
+        error.duplicate_item_contexts = duplicate_item_contexts
+        yield error
 
 
