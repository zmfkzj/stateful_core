{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "force-tag-creation": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "separate-pull-requests": false,
  "packages": {
    "crates/stateful-core": {
      "component": "stateful-core"
    },
    "crates/stateful-store": {
      "component": "stateful-store"
    },
    "crates/stateful-server": {
      "component": "stateful-server"
    },
    "crates/stateful-cli": {
      "component": "stateful-cli"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "stateful workspace",
      "components": [
        "stateful-core",
        "stateful-store",
        "stateful-server",
        "stateful-cli"
      ]
    }
  ]
}
